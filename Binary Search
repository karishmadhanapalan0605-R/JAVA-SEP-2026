
import java.util.*;

class Main {
    public static void main(String[] args) {
        int[] a = {10, 20, 30, 40, 50};
        int key = 30;
        int low = 0, high = 4;

        while(low <= high) {
            int mid = (low + high) / 2;

            if(a[mid] == key) {
                System.out.println("Found");
                break;
            }
            else if(a[mid] < key)
                low = mid + 1;
            else
                high = mid - 1;
        }
    }
}
